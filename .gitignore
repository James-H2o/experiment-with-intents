# --- IDE & Metadata ---
# We ignore the entire .idea folder to keep local configurations private
.idea/
*.iml
*.iws
*.ipr

# --- Gradle & Build Outputs ---
.gradle/
**/build/

# --- C++ / Native Build Artifacts ---
